            "parts": [
              {
                "id": "cc6.6_smt",
                "name": "statement",
                "prose": "The system is protected from threats originating outside its boundaries through boundary controls."
              }
            ]
          },
          {
            "id": "cc6.7",
            "title": "Protection of data in transit",
            "props": [
              {
                "name": "label",
                "value": "CC6.7"
              },
              {
                "name": "mapped-nist-800-53",
                "value": "sc-8"
              }
