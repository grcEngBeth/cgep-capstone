      "remarks": "Acme-authored summary catalog covering only the SOC 2 criteria this system implements. AICPA does not publish an official OSCAL catalog for the Trust Services Criteria. Titles and statements here are short paraphrases, not AICPA text. The mapped-nist-800-53 property is an illustrative crosswalk, not an authoritative one."
    },
    "groups": [
      {
        "id": "cc6",
        "title": "Logical and Physical Access Controls",
        "controls": [
          {
            "id": "cc6.1",
            "title": "Logical access security over information assets",
            "props": [
              {
                "name": "label",
                "value": "CC6.1"
              },
              {
                "name": "mapped-nist-800-53",
                "value": "sc-28"
              }
            ],
            "parts": [
              {
                "id": "cc6.1_smt",
                "name": "statement",
                "prose": "Access to information assets is restricted through logical access controls, including protection of data at rest."
