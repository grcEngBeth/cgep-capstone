            ]
          },
          {
            "id": "cc6.3",
            "title": "Authorization and least privilege",
            "props": [
              {
                "name": "label",
                "value": "CC6.3"
              },
              {
                "name": "mapped-nist-800-53",
                "value": "ac-6"
              }
            ],
            "parts": [
              {
                "id": "cc6.3_smt",
                "name": "statement",
                "prose": "Access is granted, modified, and removed based on authorization and the principle of least privilege."
              }
            ]
          },
          {
            "id": "cc6.6",
            "title": "Boundary protection",
            "props": [
              {
                "name": "label",
                "value": "CC6.6"
              },
              {
                "name": "mapped-nist-800-53",
                "value": "sc-7"
