      {
        "uuid": "2d89be56-4ab1-4e2f-ba8e-eb396fc739d0",
        "type": "software",
        "title": "patient-intake-api",
        "description": "The Acme Health Patient Intake API from the cgep-app-starter (API Gateway, Lambda, DynamoDB, S3) plus the Terraform hardening overrides that close starter gaps GAP-01 to GAP-05 and GAP-07.",
        "purpose": "Accept patient intake submissions and store PHI with SOC 2 aligned controls.",
        "responsible-roles": [
          {
            "role-id": "provider",
            "party-uuids": [
              "d4788e96-d635-485c-be9f-c48662ae436c"
            ]
          }
        ],
        "control-implementations": [
          {
            "uuid": "e0ea2d4c-89e7-4cd5-b841-d8b9c3e81405",
            "source": "../catalogs/soc2-tsc-acme.json",
            "description": "SOC 2 Trust Services Criteria implemented by this component, from the Acme Health SOC 2 summary catalog.",
            "implemented-requirements": [
              {
                "uuid": "582269bd-4a22-4186-9dff-a4f0e5855604",
                "control-id": "cc6.1",
                "description": "PHI at rest is encrypted with a customer-managed KMS key that has automatic rotation enabled. The uploads bucket uses SSE-KMS and the intake DynamoDB table uses the same key, so key custody sits with Acme and not with AWS defaults.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_kms_key.phi"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_kms_alias.phi"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_server_side_encryption_configuration.uploads"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_dynamodb_table.intake"
                  },
                  {
                    "name": "rego-policy",
                    "value": "policies/cc6_1_s3_kms.rego"
                  },
                  {
                    "name": "rego-policy",
                    "value": "policies/cc6_1_dynamodb_cmk.rego"
                  },
                  {
                    "name": "starter-gap",
                    "value": "GAP-01"
                  },
                  {
                    "name": "starter-gap",
                    "value": "GAP-02"
                  }
                ],
                "links": [
                  {
                    "rel": "evidence",
                    "href": "s3://acme-health-intake-evidence-vault-c34bf5d7/runs/38462035721/evidence-38462035721-8351cf9a762d722cd6d1f8a1d5e11635f972e957.tar.gz",
                    "text": "Signed pipeline evidence bundle from GitHub Actions run 38462035721 (plan, apply log, policy gate results) in the Object Lock vault."
                  },
                  {
                    "rel": "evidence",
                    "href": "s3://acme-health-intake-evidence-vault-c34bf5d7/runs/38462035721/evidence-38462035721-8351cf9a762d722cd6d1f8a1d5e11635f972e957.tar.gz.sig.bundle",
                    "text": "Cosign keyless signature bundle (Sigstore) for the evidence bundle above."
                  }
                ]
              },
              {
                "uuid": "68ef9af9-14b1-430e-bcf2-1cda5144daad",
                "control-id": "cc6.3",
                "description": "The Lambda execution role is limited to dynamodb:PutItem on the intake table, s3:PutObject under the uploads/ prefix, and use of the PHI key only. Wildcard actions are blocked by policy. Limitation: the policy can only evaluate IAM documents whose values are known at plan time.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_iam_role_policy.lambda_inline"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_iam_role_policy.lambda_kms"
                  },
                  {
                    "name": "rego-policy",
                    "value": "policies/cc6_3_iam_wildcards.rego"
                  },
                  {
                    "name": "starter-gap",
                    "value": "GAP-07"
                  }
                ],
                "links": [
                  {
                    "rel": "evidence",
                    "href": "s3://acme-health-intake-evidence-vault-c34bf5d7/runs/38462035721/evidence-38462035721-8351cf9a762d722cd6d1f8a1d5e11635f972e957.tar.gz",
                    "text": "Signed pipeline evidence bundle from GitHub Actions run 38462035721 (plan, apply log, policy gate results) in the Object Lock vault."
